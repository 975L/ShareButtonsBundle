    "keywords": ["symfony", "bundle", "share", "buttons"],
    "license": "MIT",
    "authors": [
        {
            "name": "Laurent Marquet",
            "email": "laurent.marquet@laposte.net",
            "homepage": "https://github.com/LaurentMarquet",
            "role": "Developer"
        },
        {
            "name": "975L Community",
            "homepage": "https://github.com/975L"
        }
    ],
    "require": {
        "php": ">=8.0",
        "c975l/config-bundle": "*"
    },
    "require-dev": {
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "c975L\\ShareButtonsBundle\\": "src/"
        }
    },
    "support": {
        "email": "contact@975l.com",
        "source": "https://github.com/975L/ShareButtonsBundle",
